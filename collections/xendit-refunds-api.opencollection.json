{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xendit Balance Refunds API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Refunds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a refund",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.xendit.co/refunds",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates a full or partial refund for a successful payment request."
        },
        {
          "info": {
            "name": "Get a refund",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.xendit.co/refunds/:refund_id",
            "params": [
              {
                "name": "refund_id",
                "value": "",
                "type": "path",
                "description": "The ID of the refund."
              }
            ]
          },
          "docs": "Retrieves a refund by ID. Modeled from Xendit's documented refund resource conventions."
        }
      ]
    }
  ],
  "bundled": true
}